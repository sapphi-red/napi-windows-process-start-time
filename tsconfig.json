{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "declaration": true,
    "isolatedDeclarations": true,
    "types": ["node"],
    "paths": {
      "napi-windows-process-start-time": ["./index.ts"]
    }
  },
  "include": ["index.ts", "scripts/**/*.ts", "test/**/*.ts", "tsdown.config.ts"]
}
