{
  "name": "napi-windows-process-start-time",
  "version": "0.1.0",
  "description": "Tiny no_std native addon for Windows process creation times",
  "keywords": [
    "napi",
    "no-std",
    "node-api",
    "process",
    "start-time",
    "windows"
  ],
  "license": "MIT",
  "files": [
    "index.mjs",
    "index.d.ts",
    "native/*.node"
  ],
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "pnpm run build && vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && cargo fmt --check && cargo clippy --lib --locked -- -D warnings",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "pkg-pr-new": "0.0.93",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.18.0"
}
