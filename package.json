{
  "name": "napi-windows-process-start-time",
  "version": "0.1.0",
  "description": "Tiny native addon for Windows process creation times",
  "keywords": [
    "napi",
    "node-api",
    "process",
    "start-time",
    "windows"
  ],
  "homepage": "https://github.com/sapphi-red/napi-windows-process-start-time#readme",
  "bugs": {
    "url": "https://github.com/sapphi-red/napi-windows-process-start-time/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapphi-red/napi-windows-process-start-time.git"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "native/*.node"
  ],
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsdown",
    "build:js": "tsdown --on-success \"\"",
    "typecheck": "pnpm run lint",
    "test": "pnpm run build && vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run format:check && pnpm run lint && cargo fmt --check && cargo clippy --lib --locked -- -D warnings",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "pkg-pr-new": "0.0.93",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.18.0"
}
