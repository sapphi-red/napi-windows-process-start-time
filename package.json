{
  "name": "napi-windows-process-start-time",
  "version": "0.1.0",
  "description": "Tiny no_std native addon for Windows process creation times",
  "keywords": [
    "napi",
    "no-std",
    "node-api",
    "process",
    "start-time",
    "windows"
  ],
  "license": "MIT",
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "native/*.node"
  ],
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run format:check && cargo fmt --check && cargo clippy --lib -- -D warnings",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "oxfmt": "^0.76.0"
  },
  "engines": {
    "node": ">=20"
  }
}
